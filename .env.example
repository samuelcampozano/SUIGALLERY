# ==========================================
# WALRUS CONSOLE CONFIGURATION & CREDENTIALS
# ==========================================
# Walrus Console: https://console.walrus.xyz
# Testnet: https://testnet.console.walrus.xyz

# OPTION 1: ALL-IN-ONE CREDENTIAL BUNDLE (RECOMMENDED)
# CONSOLE_CREDENTIAL_BUNDLE={"v":1,"apiKey":"hbr_...","serviceSecret":"suiprivkey1...","ownerAddress":"0x...","keyAdminAddress":null}

# OPTION 2: INDIVIDUAL CREDENTIALS
CONSOLE_API_KEY=hbr_your_api_key_here
CONSOLE_SERVICE_PRIVATE_KEY=suiprivkey1_your_private_key_here
CONSOLE_WEB_ACCOUNT_ADDRESS=0x_your_owner_address_here
CONSOLE_KEY_ADMIN_ADDRESS=0x_optional_admin_address_here

# MANAGEMENT / KEY-ADMIN (OPTIONAL)
CONSOLE_ADMIN_KEY=hbradm_optional_admin_key_here
CONSOLE_ADMIN_SERVICE_PRIVATE_KEY=suiprivkey1_optional_admin_private_key_here

# NETWORK & ENVIRONMENT SETTINGS
# Deployment intent is independent of NODE_ENV. Use sandbox for a disposable
# API/testnet environment; production rejects all sandbox storage fallbacks.
NODUS_DEPLOYMENT_ENV=sandbox
CONSOLE_API_BASE_URL=https://api.console.walrus.xyz
CONSOLE_MCP_ALLOWED_DIRS=/app

# Direct access to public Walrus Testnet is opt-in and is disabled forcibly
# when NODUS_DEPLOYMENT_ENV=production.
WALRUS_DIRECT_TESTNET_ENABLED=true
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# Comma-separated browser origins allowed to call the API in production.
# Example: https://app.example.com,https://admin.example.com
NODUS_ALLOWED_ORIGINS=

# PostgreSQL control-plane database. Generate a strong local value and keep .env untracked.
POSTGRES_PASSWORD=
# For Docker Compose use host `postgres`; URL-encode reserved password characters.
DATABASE_URL=

# 32-byte base64 (or 64-character hex) application key used only to encrypt
# per-endpoint webhook signing secrets at rest. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NODUS_WEBHOOK_ENCRYPTION_KEY=

# ==========================================
# DIRECT WALRUS AUTHENTICATED PUBLISHER
# ==========================================
# HTTPS base URL of the self-hosted Walrus publisher. The browser uploads
# ciphertext directly to this URL; the Nodus API never proxies segment bytes.
NODUS_PUBLISHER_URL=https://publisher.example.com

# HMAC secret configured in the publisher's --jwt-decode-secret option.
# Keep this value only on the Nodus control-plane server.
NODUS_PUBLISHER_JWT_SECRET=replace_with_a_32_byte_random_secret

# Dedicated receipt-verification key. The publisher signs each completed upload
# receipt with this key; it must not equal the JWT key in production.
NODUS_PUBLISHER_RECEIPT_SECRET=replace_with_a_different_32_byte_random_secret

# JWT lifetime in seconds. Tokens are single-use and should remain short-lived.
NODUS_PUBLISHER_TOKEN_TTL_SECONDS=600
